<%# Steps 2 and 3 — field layout and template authoring.
    This ERB is only the mount shell; the builder itself is the Vue app in
    core at app/frontend/src/easy_form_designer/. Same pattern as
    easy_automations_rules/new.html.erb. %>
<%= title [l("easy_form_designer.label_forms"), easy_form_designer_forms_path], @form.name %>

<div class="contextual">
  <% if @form.status_published? %>
    <%= ds_button(value: l(:button_unpublish, default: "Unpublish"),
                  variant: :secondary,
                  href: unpublish_easy_form_designer_form_path(@form),
                  data: { turbo_method: :post }) %>
    <%= ds_button(value: l("easy_form_designer.label_open_form"),
                  variant: :secondary,
                  href: new_easy_form_designer_form_submission_path(@form)) %>
  <% else %>
    <%= ds_button(value: l(:button_publish, default: "Publish"),
                  variant: :primary,
                  disabled: !@form.publishable?,
                  href: publish_easy_form_designer_form_path(@form),
                  data: { turbo_method: :post }) %>
  <% end %>
</div>

<% unless @form.publishable? %>
  <%= ds_alert(variant: :warning, body: l("easy_form_designer.error.unmapped_field")) %>
<% end %>

<div id="app-easy-form-designer"
     data-form-id="<%= @form.id %>"
     data-project-id="<%= @form.project_id %>"
     data-tracker-id="<%= @form.tracker_id %>"
     data-attributes-url="<%= easy_form_designer_attributes_path %>"
     data-initial-id="app-easy-form-designer-initial"></div>

<%# Existing fields/templates for the builder to hydrate from on mount —
    without this the canvas always starts blank, even for a form that
    already has saved fields, because the Vue app has no other way to know
    what is already in the database. json_escape neutralises "</script>"
    inside any saved label/help text so it can't break out of the tag. %>
<script type="application/json" id="app-easy-form-designer-initial"><%= raw json_escape(form_json(@form).to_json) %></script>

<script defer>
  EASY.schedule.late(() => {
    window.EasyFormDesigner?.createBuilderApp({
      rootContainerId: "app-easy-form-designer"
    });
  });
</script>
